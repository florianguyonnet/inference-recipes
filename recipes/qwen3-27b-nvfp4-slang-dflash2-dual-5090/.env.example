# ---------------------------------------------------------------------------
# SGLang + DFlash2 — Qwen3.8-27B-NVFP4 on dual RTX 5090, native 262k context
# Image: built locally from ./Dockerfile (SGLang nightly moved to the DFlash2
# merge commit). Copy this file to .env and adjust values.
# ---------------------------------------------------------------------------

IMAGE=sglang-dflash2:local
CONTAINER_NAME=sglang-dflash2

# Host HF cache, mounted into the container (target ~25 GiB + drafter ~4 GiB).
HF_HOME=${PROJECT_DIR}/cache/huggingface
# HF_TOKEN=hf_...

# Target: NVFP4 with an UNQUANTIZED lm_head. DFlash2's candidate selector runs
# top-K through the target head and rejects a quantized one, which rules out the
# RadixArk checkpoint the DSpark recipe serves (NVFP4 lm_head).
HF_REPO_ID=Inferact/Qwen3.8-27B-NVFP4
DFLASH_DRAFT_ID=incoai/Qwen3.8-27B-DFlash2
# Verify width: the drafter's block size is 8 (7 proposals + the anchor).
NUM_DRAFT_TOKENS=8
# SPEC=off serves the same checkpoint without the drafter (bench baseline).
SPEC=dflash

GPUS=all
# KVM/QEMU: PCIe P2P may hang NCCL.
NCCL_P2P_DISABLE=1

# Server
SGLANG_HOST=0.0.0.0
SGLANG_PORT=30100
SERVED_MODEL_NAME=Qwen3.8-27B-NVFP4

# Serving shape (see the DSpark recipe for why the GDN state pool is pinned).
TP=2
MEM_FRACTION=0.90
CONTEXT_LENGTH=262144
CHUNKED_PREFILL=2048
KV_CACHE_DTYPE=fp8_e4m3
MAMBA_SSM_DTYPE=bfloat16
MAMBA_FULL_MEMORY_RATIO=8.26
MAMBA_CACHE_SIZE=96
MAX_RUNNING_REQUESTS=8
ATTENTION_BACKEND=flashinfer

# Optional:
# EXTRA_FLAGS="--foo bar"          # passthrough to launch_server, appended last
