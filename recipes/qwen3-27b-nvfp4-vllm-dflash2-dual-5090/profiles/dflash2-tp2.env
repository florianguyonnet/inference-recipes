# Profile: DFlash2 drafter on both GPUs (baseline of this recipe).
CUDA_VISIBLE_DEVICES=0,1
GPUS=all
TENSOR_PARALLEL_SIZE=2

VLLM_PORT=8100
CONTAINER_NAME=vllm-dflash2
SERVED_MODEL_NAME=Qwen3.8-27B-NVFP4

SPEC=on
NUM_SPECULATIVE_TOKENS=7

# 0.94 (what the no-drafter recipe runs) OOMs on the first GDN prefill here:
# drafter weights + its CUDA graphs leave nothing for the FLA kernel workspace.
GPU_MEMORY_UTILIZATION=0.88
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
