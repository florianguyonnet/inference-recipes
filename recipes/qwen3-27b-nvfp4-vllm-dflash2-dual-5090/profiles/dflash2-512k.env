# Profile: serving shape — unsloth NVFP4 at 512k (YaRN 2.0) + DFlash2, port 8000.
#
# Two overlays are built inside the mounted cache on every start:
#   - the target's YaRN config (262k checkpoint -> 512k window)
#   - the drafter's position table (262144 -> 524288), without which a prompt
#     past 262k dies on a device-side assert. See README.
# max-num-seqs 4 keeps the verify batch small: TPOT stays flat under a burst and
# requests beyond 4 queue. util 0.94 is the ceiling — 0.95 OOMs on a long prefill.
CUDA_VISIBLE_DEVICES=0,1
GPUS=all
TENSOR_PARALLEL_SIZE=2

VLLM_HOST=0.0.0.0
VLLM_PORT=8000
CONTAINER_NAME=vllm-dflash2
SERVED_MODEL_NAME=Qwen3.8-27B-NVFP4

HF_REPO_ID=unsloth/Qwen3.8-27B-NVFP4
YARN_OVERLAY=1
DRAFT_REPO_ID=incoai/Qwen3.8-27B-DFlash2
DRAFTER_OVERLAY=1
SPEC=on
NUM_SPECULATIVE_TOKENS=7

GPU_MEMORY_UTILIZATION=0.92
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192

# Serving, not experimenting: come back after a crash or a reboot.
RESTART_POLICY=unless-stopped
