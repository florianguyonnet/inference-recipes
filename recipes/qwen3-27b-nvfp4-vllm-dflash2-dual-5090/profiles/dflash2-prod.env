# Profile: production shape — DFlash2 on both GPUs, port 8000.
#
# Latency over aggregate throughput: max-num-seqs 4 keeps the verify batch at
# 4x8 tokens, which holds TPOT at 8-9 ms even under a 16-request burst (16 seqs
# gives 27 ms) and pays for utilization 0.92. Costs 12% of aggregate throughput
# above 4 concurrent; requests 5+ queue rather than degrade.
CUDA_VISIBLE_DEVICES=0,1
GPUS=all
TENSOR_PARALLEL_SIZE=2

VLLM_PORT=8000
CONTAINER_NAME=vllm-dflash2
SERVED_MODEL_NAME=Qwen3.8-27B-NVFP4

SPEC=on
NUM_SPECULATIVE_TOKENS=7

GPU_MEMORY_UTILIZATION=0.92
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192
