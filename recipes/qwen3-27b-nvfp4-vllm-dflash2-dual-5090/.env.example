# ---------------------------------------------------------------------------
# vLLM + DFlash2 — Qwen3.8-27B-NVFP4 on dual RTX 5090, native 262k context
# Image: built locally from ./Dockerfile (vLLM nightly + DFlash2 PRs).
# Copy this file to .env and adjust values.
# ---------------------------------------------------------------------------

IMAGE=vllm-dflash2:local
CONTAINER_NAME=vllm-dflash2

# Host HF cache, mounted into the container (target ~25 GiB + drafter ~4 GiB).
HF_HOME=${PROJECT_DIR}/cache/huggingface
# HF_TOKEN=hf_...

# Target: NVFP4 with an UNQUANTIZED lm_head. DFlash2's candidate selector runs
# top-K through the target head and refuses a quantized one, which rules out the
# unsloth and RadixArk NVFP4 checkpoints (both quantize lm_head).
HF_REPO_ID=Inferact/Qwen3.8-27B-NVFP4
# Drafter: 2B, bf16, 8-token block (7 draft tokens per verification step).
DRAFT_REPO_ID=incoai/Qwen3.8-27B-DFlash2
NUM_SPECULATIVE_TOKENS=7
# SPEC=off serves the same checkpoint without the drafter (bench baseline).
SPEC=on

# GPUs the container sees: "all" for TP=2, "device=0" for single card.
GPUS=all
CUDA_VISIBLE_DEVICES=0,1

# KVM/QEMU: PCIe P2P may hang NCCL.
NCCL_P2P_DISABLE=1
VLLM_SKIP_P2P_CHECK=1

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TORCH_CUDA_ARCH_LIST=12.0
VLLM_USE_FLASHINFER_SAMPLER=1
# pip toolkit vs runtime headers CCCL check (needed for flashinfer JIT).
FLASHINFER_EXTRA_CUDAFLAGS=-DCCCL_DISABLE_CTK_COMPATIBILITY_CHECK=1
# ninja parallelism during JIT (each nvcc job peaks ~8 GB RAM).
MAX_JOBS=4

# Server
VLLM_HOST=0.0.0.0
VLLM_PORT=8100
SERVED_MODEL_NAME=Qwen3.8-27B-NVFP4

# Serving shape.
TENSOR_PARALLEL_SIZE=2
GPU_MEMORY_UTILIZATION=0.94
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=16
MAX_NUM_BATCHED_TOKENS=8192
ATTENTION_BACKEND=flashinfer

# Optional:
# EXTRA_FLAGS="--foo bar"          # passthrough to vllm serve, appended last
