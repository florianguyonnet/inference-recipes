# The goal: SGLang + DSpark on both RTX 5090.
#
# Tuning sweep results (probe_decode.py, fixed prompts at temp 0.6, TP=2):
#   block7 baseline   med 126 / max 238 tok/s
#   block5            med 119 / max 234
#   block6            med 149 / max 212
#   attn-mode decode  med 147 / max 220
#   block6+decode     med 130-137 / max 275 (two passes)
#   tp1 block7        med 145 / max 200
# Verdict: all within run-to-run noise (the same prompt swings 200-275 tok/s
# across identical configs). Keep the auto-inferred block 7; don't chase this.
TP=2
GPUS=all
SPEC=dspark

# Server-side default temperature for clients that don't set one. The
# checkpoint's generation_config says 1.0; the DSpark evaluation used 0.6,
# which also matches the drafter's training distribution (better acceptance).
# Implemented as a generation_config overlay (see start.sh).
GEN_CONFIG_TEMP=0.6

# Explicit pool pins (override the ratio): 8 concurrent
# requests x (S=4 lazy + D=8 DSpark) = 96 slots. Ratio-only sizing spirals:
# at high VRAM the pool grows, and the spec intermediates (x8 verify tokens)
# grow with it until warmup OOM.
MAMBA_CACHE_SIZE=96
MAX_RUNNING_REQUESTS=8
