# ---------------------------------------------------------------------------
# SGLang (Docker) — Qwen3.8-27B-NVFP4 + DSpark on RTX 5090
# Image: lmsysorg/sglang:qwen38-27b (the cookbook's model-specific build;
# pip sglang 0.5.17 has a broken DSpark path for this checkpoint).
# Copy this file to .env and adjust values.
# ---------------------------------------------------------------------------

# Docker image and container name
IMAGE=lmsysorg/sglang:qwen38-27b
CONTAINER_NAME=sglang-qwen38

# Host HF cache, mounted into the container (weights are downloaded by the
# container on first start, or pre-seeded by running scripts/download_model.sh)
HF_HOME=${PROJECT_DIR}/cache/huggingface
# Optional: Hugging Face token for higher rate limits
# HF_TOKEN=hf_...

# Server bind (container runs --network host, so this is the host port)
SGLANG_HOST=0.0.0.0
SGLANG_PORT=30000
SERVED_MODEL_NAME=Qwen3.8-27B-NVFP4

# Checkpoints
HF_REPO_ID=RadixArk/Qwen3.8-27B-NVFP4
DSPARK_DRAFT_ID=RadixArk/Qwen3.8-27B-DSpark

# Tensor parallelism. 2 = both RTX 5090 (recommended: VRAM-comfortable,
# highest concurrency). 1 = cookbook baseline cell for rtx5090.
TP=2

# Which GPUs the container sees: "all" for TP=2, "device=0" for TP=1
GPUS=all

# Speculative decoding: dspark (the ~200 tok/s config) or off (greedy).
SPEC=dspark

# Cookbook SM120 flags
ATTENTION_BACKEND=flashinfer
MEM_FRACTION=0.90
CHUNKED_PREFILL=2048
KV_CACHE_DTYPE=fp8_e4m3
CONTEXT_LENGTH=262144

# GDN (mamba) state pool sizing — the flag that makes or breaks this model.
# Default ratio (0.9) over-provisions KV and silently clamps concurrency.
# 8.26 = (S+D) x state_bytes / (L x kv_bytes_per_token) for S=4, D=8, bf16
# states, L~7.6k tokens. Recompute for your average request length with the
# cookbook's mamba ratio calculator.
MAMBA_SSM_DTYPE=bfloat16
MAMBA_STRATEGY=extra_buffer_lazy
MAMBA_FULL_MEMORY_RATIO=8.26
# Optional explicit pins (override the ratio). Empty = ratio-driven.
MAMBA_CACHE_SIZE=
MAX_RUNNING_REQUESTS=

# DSpark: run GDN verify on a separate backend (per the DSpark recipe).
LINEAR_ATTN_VERIFY_BACKEND=triton

# Server-side default temperature for clients that don't set one. The
# checkpoint says 1.0; the DSpark evaluation used 0.6 (better acceptance).
# Empty = keep the checkpoint default. Requires --sampling-defaults model.
GEN_CONFIG_TEMP=0.6

# Vision feature transport: cpu works everywhere; cuda_ipc is zero-copy but
# needs --privileged (or ptrace_scope=0) for pidfd_getfd between processes.
MM_TRANSPORT=cpu
