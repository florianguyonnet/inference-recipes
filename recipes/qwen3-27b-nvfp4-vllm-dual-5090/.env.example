# ---------------------------------------------------------------------------
# vLLM (Docker) — Qwen3.8-27B-NVFP4 on dual RTX 5090, 512k context via YaRN
# Image: vllm/vllm-openai:v0.27.1 (matches the versions validated in README).
# Copy this file to .env and adjust values.
# ---------------------------------------------------------------------------

IMAGE=vllm/vllm-openai:v0.27.1
CONTAINER_NAME=vllm-qwen

# Host HF cache, mounted into the container (weights ~23 GiB + YaRN overlay).
HF_HOME=${PROJECT_DIR}/cache/huggingface
# HF_TOKEN=hf_...

# Checkpoint (compressed-tensors NVFP4 W4A4 MLP + FP8 attention, auto-detected).
# The YaRN 512k overlay is built by start.sh inside the cache.
HF_REPO_ID=unsloth/Qwen3.8-27B-NVFP4
# Set to 0 to serve the raw checkpoint (native 262k) instead of the overlay.
YARN_OVERLAY=1

# GPUs the container sees: "all" for TP=2, "device=0" for single card.
GPUS=all
CUDA_VISIBLE_DEVICES=0,1

# KVM/QEMU: PCIe P2P may hang NCCL.
NCCL_P2P_DISABLE=1
VLLM_SKIP_P2P_CHECK=1

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
TORCH_CUDA_ARCH_LIST=12.0
VLLM_USE_FLASHINFER_SAMPLER=1
# pip toolkit vs runtime headers CCCL check (needed for flashinfer JIT).
FLASHINFER_EXTRA_CUDAFLAGS=-DCCCL_DISABLE_CTK_COMPATIBILITY_CHECK=1
# ninja parallelism during JIT (each nvcc job peaks ~8 GB RAM).
MAX_JOBS=4

# Server
VLLM_HOST=0.0.0.0
VLLM_PORT=8000
SERVED_MODEL_NAME=Qwen3.8-27B-NVFP4

# Serving shape (validated values, see README for the why).
TENSOR_PARALLEL_SIZE=2
GPU_MEMORY_UTILIZATION=0.94
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
ATTENTION_BACKEND=flashinfer

# Optional:
# QUANTIZATION=modelopt            # only for the NVIDIA checkpoints
# SPECULATIVE_CONFIG='...'         # MTP: evaluated and rejected, see README
# EXTRA_FLAGS="--foo bar"          # passthrough to vllm serve
