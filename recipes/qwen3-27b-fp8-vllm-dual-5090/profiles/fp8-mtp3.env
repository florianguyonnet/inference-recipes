# Profile: FP8 + MTP, 3 speculative tokens, 512k (YaRN 2.0), both GPUs.
#
# max-num-seqs 4 is load-bearing, not a preference: at 16 the MTP verify batch
# reaches a shape where this build collapses (k=4: 31 tok/s at 16 concurrent,
# then the engine dies). Capped at 4, throughput stays flat past the cap
# because requests queue. See README for the full k sweep.
CUDA_VISIBLE_DEVICES=0,1
GPUS=all
TENSOR_PARALLEL_SIZE=2

VLLM_HOST=0.0.0.0
VLLM_PORT=8001
CONTAINER_NAME=vllm-qwen-fp8
SERVED_MODEL_NAME=Qwen3.8-27B-FP8
HF_REPO_ID=Qwen/Qwen3.8-27B-FP8
YARN_OVERLAY=1

SPECULATIVE_CONFIG='{"method":"mtp","num_speculative_tokens":3}'

GPU_MEMORY_UTILIZATION=0.94
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=8192

MAX_JOBS=4
VLLM_USE_FLASHINFER_SAMPLER=1
FLASHINFER_EXTRA_CUDAFLAGS=-DCCCL_DISABLE_CTK_COMPATIBILITY_CHECK=1
